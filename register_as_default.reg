Windows Registry Editor Version 5.00

; ========================================================
; GhostView Windows Varsayilan Uygulama Kayit Dosyasi
; ========================================================

; 1. ProgID Kaydi
[HKEY_CURRENT_USER\Software\Classes\GhostView.Image]
@="GhostView"
"FriendlyTypeName"="GhostView"

[HKEY_CURRENT_USER\Software\Classes\GhostView.Image\DefaultIcon]
@="E:\\0_SkySoft\\PhotoViewer\\GhostView.exe,0"

[HKEY_CURRENT_USER\Software\Classes\GhostView.Image\shell]
@="open"

[HKEY_CURRENT_USER\Software\Classes\GhostView.Image\shell\open]
@="GhostView"

[HKEY_CURRENT_USER\Software\Classes\GhostView.Image\shell\open\command]
@="\"E:\\0_SkySoft\\PhotoViewer\\GhostView.exe\" \"%1\""

; 2. Uygulama Kaydi (Birlikte Ac Listesi)
[HKEY_CURRENT_USER\Software\Classes\Applications\GhostView.exe]
"FriendlyAppName"="GhostView"

[HKEY_CURRENT_USER\Software\Classes\Applications\GhostView.exe\SupportedTypes]
".jpg"=""
".jpeg"=""
".png"=""
".bmp"=""
".gif"=""
".webp"=""
".ico"=""
".tif"=""
".tiff"=""
".jfif"=""

[HKEY_CURRENT_USER\Software\Classes\Applications\GhostView.exe\shell\open\command]
@="\"E:\\0_SkySoft\\PhotoViewer\\GhostView.exe\" \"%1\""

; 3. Windows Varsayilan Uygulamalar Yetenekleri (Capabilities)
[HKEY_CURRENT_USER\Software\GhostView\Capabilities]
"ApplicationName"="GhostView"
"ApplicationDescription"="GhostView"

[HKEY_CURRENT_USER\Software\GhostView\Capabilities\FileAssociations]
".jpg"="GhostView.Image"
".jpeg"="GhostView.Image"
".png"="GhostView.Image"
".bmp"="GhostView.Image"
".gif"="GhostView.Image"
".webp"="GhostView.Image"
".ico"="GhostView.Image"
".tif"="GhostView.Image"
".tiff"="GhostView.Image"
".jfif"="GhostView.Image"

[HKEY_CURRENT_USER\Software\RegisteredApplications]
"GhostView"="Software\\GhostView\\Capabilities"

; 4. Dosya Uzantilarina Baglama
[HKEY_CURRENT_USER\Software\Classes\.jpg]
@="GhostView.Image"

[HKEY_CURRENT_USER\Software\Classes\.jpeg]
@="GhostView.Image"

[HKEY_CURRENT_USER\Software\Classes\.png]
@="GhostView.Image"

[HKEY_CURRENT_USER\Software\Classes\.bmp]
@="GhostView.Image"

[HKEY_CURRENT_USER\Software\Classes\.gif]
@="GhostView.Image"

[HKEY_CURRENT_USER\Software\Classes\.webp]
@="GhostView.Image"

[HKEY_CURRENT_USER\Software\Classes\.ico]
@="GhostView.Image"

[HKEY_CURRENT_USER\Software\Classes\.tif]
@="GhostView.Image"

[HKEY_CURRENT_USER\Software\Classes\.tiff]
@="GhostView.Image"

[HKEY_CURRENT_USER\Software\Classes\.jfif]
@="GhostView.Image"

[HKEY_CURRENT_USER\Software\Classes\.jpg\OpenWithProgids]
"GhostView.Image"=""

[HKEY_CURRENT_USER\Software\Classes\.jpeg\OpenWithProgids]
"GhostView.Image"=""

[HKEY_CURRENT_USER\Software\Classes\.png\OpenWithProgids]
"GhostView.Image"=""

[HKEY_CURRENT_USER\Software\Classes\.bmp\OpenWithProgids]
"GhostView.Image"=""

[HKEY_CURRENT_USER\Software\Classes\.gif\OpenWithProgids]
"GhostView.Image"=""

[HKEY_CURRENT_USER\Software\Classes\.webp\OpenWithProgids]
"GhostView.Image"=""

[HKEY_CURRENT_USER\Software\Classes\.ico\OpenWithProgids]
"GhostView.Image"=""

[HKEY_CURRENT_USER\Software\Classes\.tif\OpenWithProgids]
"GhostView.Image"=""

[HKEY_CURRENT_USER\Software\Classes\.tiff\OpenWithProgids]
"GhostView.Image"=""

[HKEY_CURRENT_USER\Software\Classes\.jfif\OpenWithProgids]
"GhostView.Image"=""
